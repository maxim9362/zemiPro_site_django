# Copy to an untracked .env.staging ONLY on an approved isolated staging host.
# Empty secrets intentionally fail Docker Compose config until filled.
# Never reuse existing production or legacy credentials.
STAGING_DOMAIN=staging.example.invalid
STAGING_DB_PASSWORD=
STAGING_DJANGO_SECRET_KEY=

# For public automatic HTTPS certificate issuance, ports must be reachable
# as 80/443 for the above domain (or use an approved ingress forwarding them).
STAGING_BIND_IP=0.0.0.0
STAGING_HTTP_PORT=80
STAGING_HTTPS_PORT=443

# Resource ceilings for a small *isolated* staging host; tune after measurement.
STAGING_DB_MEMORY=320m
STAGING_WEB_MEMORY=384m
STAGING_PROXY_MEMORY=96m

# Optional auth integrations. Leave disabled until owner-approved staging
# credentials, callback URL and SMTP sender are configured outside Git.
ZEMIPRO_GOOGLE_LOGIN_ENABLED=False
ZEMIPRO_GOOGLE_CLIENT_ID=
ZEMIPRO_GOOGLE_CLIENT_SECRET=
ZEMIPRO_CONTACT_DELIVERY_MODE=disabled
ZEMIPRO_SMTP_HOST=
ZEMIPRO_SMTP_PORT=587
ZEMIPRO_SMTP_USERNAME=
ZEMIPRO_SMTP_PASSWORD=
ZEMIPRO_EMAIL_FROM=
