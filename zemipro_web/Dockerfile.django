# syntax=docker/dockerfile:1.7
# Python/Django runtime only. Development and staging share this image.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/django

WORKDIR /app

COPY requirements.txt /app/requirements.txt
# ``build_ca`` is optional and is used only by managed development runners
# whose HTTPS proxy has a private CA. The certificate is a BuildKit secret: it
# is never copied into an image layer. Normal local/CI builds use system trust.
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then \
        PIP_CERT=/run/secrets/build_ca python -m pip install --no-cache-dir -r /app/requirements.txt; \
    else \
        python -m pip install --no-cache-dir -r /app/requirements.txt; \
    fi

RUN groupadd --gid 10001 django \
    && useradd --uid 10001 --gid django --create-home --home-dir /home/django --shell /usr/sbin/nologin django \
    && mkdir -p /app/staticfiles /app/media /app/docker \
    && chown -R django:django /app /home/django \
    && chmod 0700 /home/django

COPY --chown=django:django . /app/
RUN chmod 0755 /app/docker/entrypoint.sh

USER django:django
EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint.sh"]
# WEB_CONCURRENCY controls workers (staging: 1 on a small isolated host).
CMD ["gunicorn", "core.wsgi:application", "--bind", "0.0.0.0:8000", "--threads", "2", "--timeout", "30"]
