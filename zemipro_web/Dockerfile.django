# Python/Django runtime only. Development and staging share this image.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt

RUN groupadd --gid 10001 django \
    && useradd --uid 10001 --gid django --no-create-home --shell /usr/sbin/nologin django \
    && mkdir -p /app/staticfiles /app/media /app/docker \
    && chown -R django:django /app

COPY --chown=django:django . /app/
RUN chmod 0755 /app/docker/entrypoint.sh

USER django:django
EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint.sh"]
# WEB_CONCURRENCY controls workers (staging: 1 on a small isolated host).
CMD ["gunicorn", "core.wsgi:application", "--bind", "0.0.0.0:8000", "--threads", "2", "--timeout", "30"]
