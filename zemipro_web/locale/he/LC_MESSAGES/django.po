msgid "Новый отклик"
msgstr "תגובה חדשה"

msgid "Системное"
msgstr "התראת מערכת"

msgid "Ваша заявка №%(number)s успешно создана. Мастера смогут откликнуться на неё."
msgstr "הבקשה שלך מספר %(number)s נוצרה. אנשי מקצוע יכולים להגיב לה."

msgid "Мастер откликнулся на вашу заявку №%(number)s."
msgstr "איש מקצוע הגיב לבקשה שלך מספר %(number)s."

msgid "Клиент выбрал вас исполнителем по заявке №%(number)s."
msgstr "לקוח בחר בך לבקשה מספר %(number)s."

msgid "По заявке №%(number)s клиент выбрал другого мастера."
msgstr "הלקוח בחר באיש מקצוע אחר לבקשה מספר %(number)s."

msgid "Заявка №%(number)s, на которую вы откликались, была отменена клиентом."
msgstr "הבקשה מספר %(number)s שעליה הגבת בוטלה על ידי הלקוח."

msgid "Клиент отметил заявку №%(number)s как выполненную."
msgstr "הלקוח סימן את בקשה מספר %(number)s כהושלמה."

msgid "Клиент оставил отзыв по заявке №%(number)s."
msgstr "לקוח כתב חוות דעת על בקשה מספר %(number)s."

msgid "Страницы активных заявок"
msgstr "עמודי הבקשות הפעילות"

msgid "Страницы заявок в процессе"
msgstr "עמודי בקשות בתהליך"

msgid "Страницы завершённых заявок"
msgstr "עמודי בקשות שהושלמו"

msgid "Страницы отменённых заявок"
msgstr "עמודי בקשות שבוטלו"

msgid "Поиск специалистов в городе"
msgstr "חיפוש אנשי מקצוע בעיר"

msgid "Специалисты в городе"
msgstr "אנשי מקצוע בעיר"

msgid "Пока нет подходящих специалистов"
msgstr "אין עדיין אנשי מקצוע מתאימים"

msgid "категорий"
msgstr "קטגוריות"

msgid "Открыть заявку №"
msgstr "פתיחת בקשה מספר"
