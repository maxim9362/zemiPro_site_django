# Select one: development, test, staging, production.
DJANGO_ENV=development

# Development may use the safe local fallback key. Staging and production
# require an explicit random value with at least 50 characters.
DJANGO_SECRET_KEY=django-insecure-development-only-key-never-use-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL. The local defaults below are development-only. Staging and
# production require explicit non-empty DB_NAME, DB_USER, DB_PASSWORD, DB_HOST.
DB_NAME=zemipro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Secure staging/production defaults. Uncomment only to override an
# environment's safe defaults deliberately.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

# Enable only behind a trusted reverse proxy that sets X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=False
