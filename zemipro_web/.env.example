# Local development only. Never place real credentials into this file.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-development-only-key-never-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local isolated PostgreSQL (replace in your untracked .env if necessary).
DB_NAME=zemipro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Staging/production require their own strong DJANGO_SECRET_KEY, allowed hosts,
# non-placeholder DB password, and physically separate databases.
# HTTPS, secure cookies and HSTS are enabled in secure environments.
# Enable this only when a trusted reverse proxy rewrites X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=False
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

# Authentication providers are disabled by default. Keep real values only in
# an untracked environment/secret manager; never commit them.
ZEMIPRO_GOOGLE_LOGIN_ENABLED=False
ZEMIPRO_GOOGLE_CLIENT_ID=
ZEMIPRO_GOOGLE_CLIENT_SECRET=
ZEMIPRO_CONTACT_DELIVERY_MODE=disabled
ZEMIPRO_SMTP_HOST=
ZEMIPRO_SMTP_PORT=587
ZEMIPRO_SMTP_USERNAME=
ZEMIPRO_SMTP_PASSWORD=
ZEMIPRO_EMAIL_FROM=
